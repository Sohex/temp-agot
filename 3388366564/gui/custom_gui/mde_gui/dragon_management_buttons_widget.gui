widget = {
	name = "dragon_management_buttons_widget"
	parentanchor = bottom|right
	widgetanchor = bottom|right
	position = { -631 0 }
	size = { 400 36 }
	visible = "[ActuallyPlayingGame]"
	alwaystransparent = no
	layer = bottom
	flowcontainer = {
		ignoreinvisible = yes
		parentanchor = bottom|right
		#scale = 1.1
		button_round  = {
			visible = "[GetScriptedGui('mde_show_dragonpit_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_dragonpits_button"
			datacontext = "[GetScriptedGui( 'mde_show_dragonpit_button' )]"
			tooltip = "SHOW_DRAGONPITS"
			button_icon_highlight = {
				texture = "gfx/interface/icons/building_types/icon_building_dragonpit.dds"
				parentanchor = center
				alwaystransparent = yes
				position = { 1 1.5 }
				size = { 23 23 }
			}
			button_normal = {
				visible = "[Not(GetVariableSystem.Exists( 'dragonpits_viewer_toggle' ))]"
				size = { 100% 100% }
				parentanchor = center
				effectname = "NoHighlight"
				onclick = "[GetVariableSystem.Set('dragonpits_viewer_mode', 'viewer_mode_all')]"
				onclick = "[GetVariableSystem.Toggle('dragonpits_viewer_toggle')]"
			}
			button_normal = {
				visible = "[And(GetVariableSystem.Exists( 'dragonpits_viewer_toggle' ), GetVariableSystem.HasValue('dragonpits_viewer_mode', 'viewer_mode_available'))]"
				size = { 100% 100% }
				parentanchor = center
				effectname = "NoHighlight"
				onclick = "[GetVariableSystem.Set('dragonpits_viewer_mode', 'viewer_mode_all')]"
			}
			button_normal = {
				visible = "[And(GetVariableSystem.Exists( 'dragonpits_viewer_toggle' ), GetVariableSystem.HasValue('dragonpits_viewer_mode', 'viewer_mode_all'))]"
				size = { 100% 100% }
				parentanchor = center
				effectname = "NoHighlight"
				onclick = "[GetVariableSystem.Toggle('dragonpits_viewer_toggle')]"
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_dragon_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_dragons_button"
			onclick = "[GetVariableSystem.Toggle('dragon_viewer_toggle')]"
			tooltip = "SHOW_DRAGONS"
			button_icon_highlight = {
				texture = "gfx/interface/icons/flat_icons/capture_wild_dragon.dds"
				parentanchor = center
				alwaystransparent = yes
				position = { 1 1.5 }
				size = { 35 35 }
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_egg_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_eggs_button"
			datacontext = "[GetScriptedGui( 'mde_show_egg_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			onclick = "[GetVariableSystem.Toggle('egg_viewer_toggle')]"
			tooltip = "SHOW_EGGS"
			button_icon_highlight = {
				texture = "gfx/interface/icons/artifact/dragon_egg_black.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 40 40 }
				alpha = -3500
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_kingsguard_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_kingsguard_button"
			datacontext = "[GetScriptedGui( 'mde_show_kingsguard_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			onclick = "[GetVariableSystem.Toggle('kingsguard_viewer_toggle')]"
			tooltip = "SHOW_KINGSGUARD"
			button_icon_highlight = {
				texture = "gfx/interface/icons/flat_icons/kingsguard_flat_black.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 36 36 }
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_valyrian_steel_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_valyrian_steel_button"
			datacontext = "[GetScriptedGui( 'mde_show_valyrian_steel_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			onclick = "[GetVariableSystem.Toggle('valyrian_steel_viewer_toggle')]"
			tooltip = "SHOW_VALYRIAN_STEEL"
			button_icon_highlight = {
				texture = "gfx/interface/icons/inventory/weapon.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 31 31 }
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_dragonblood_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_dragonblood_button"
			datacontext = "[GetScriptedGui( 'mde_show_dragonblood_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			onclick = "[GetVariableSystem.Toggle('dragonblood_viewer_toggle')]"
			tooltip = "SHOW_DRAGONBLOOD"
			icon = {
				texture = "gfx/interface/icons/portraits/relation.dds"
				framesize = { 40 40 }
				frame = 1
				parentanchor = center
				alwaystransparent = yes
				size = { 24 24 }
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_artifact_market_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			enabled = "[GetScriptedGui('mde_show_artifact_market_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_artifact_market_button"
			datacontext = "[GetScriptedGui( 'mde_show_artifact_market_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "SHOW_ARTIFACT_MARKET"
			button_icon_highlight = {
				texture = "gfx/interface/icons/inventory/trinket.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 31 31 }
			}
		}
		button_round  = {
			visible = "[GetScriptedGui('mde_show_menu_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			name = "mde_menu_button"
			tooltip = "SHOW_MENU_MENU"
			onclick = "[GetScriptedGui('mde_refresh_menu_button_availability').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			onclick = "[GetVariableSystem.Toggle('menu_viewer_toggle')]"
			button_icon_highlight = {
				texture = "gfx/interface/icons/flat_icons/menu.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 20 20 }
			}
		}
		spacer = {
			visible = "[And(And(GetScriptedGui('mde_button_spacer_for_hud_skins').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			size = { 12 0 } 
		}
	}
}
