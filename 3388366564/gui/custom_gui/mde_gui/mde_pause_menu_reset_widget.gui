widget = {
	name = "mde_pause_menu_reset_widget"
	visible = "[IsPauseMenuShown]"
	size = { 300 80 }
	position = { 300 897 }
	allow_outside = yes
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		position = { 300 897 }
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		position_y = 907
	}
	alwaystransparent = no
	layer = confirmation
	button_replace = {
		name = "mde_reset_buttons_button"
		size = { 20 20 }
		position = { 0 3 }
		tooltip = "MDE_RETURN_BUTTONS_TT"
		onclick = "[GetScriptedGui( 'mde_reset_menu_buttons' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}

	text_single = {
		name = "mde_build_version_text"
		position = { 20 0 }
		tooltip = "MDE_VERSION_BUILD_TT"
		using = tooltip_below
		text = "MDE_VERSION_BUILD"
		max_width = 300
	}
}
