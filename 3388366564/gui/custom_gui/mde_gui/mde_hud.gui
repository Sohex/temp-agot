types HUD
{
    type bottom_left_dragon_portrait = container 
	{
		datacontext = "[GetPlayer]"
		visible = "[And(ShouldShowHudPortraits, GetScriptedGui('agot_can_have_dragon').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		visible_at_creation = no
		parentanchor = bottom|left


		state = {
			name = _show
			using = Animation_Curve_Default
			duration = 0.15

			position = { 0 0 }
			alpha = 1
		}

		state = {
			name = _hide
			using = Animation_Curve_Default
			duration = 0.15

			position = { 0 50 }
			alpha = 0
		}

		agot_hud_baby_dragon_portrait = {
			visible_at_creation = no
			scale = 1.72
			parentanchor = center
			position = { 20 0 }
			visible = "[GetScriptedGui( 'mde_dragon_portrait_size_baby' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}

		agot_hud_dragon_portrait = {
			visible_at_creation = no
			scale = 1.72
			parentanchor = center
			position = { -80 100 }
			visible = "[GetScriptedGui( 'mde_dragon_portrait_size_normal' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}

		agot_hud_giant_dragon_portrait = {
			visible_at_creation = no
			scale = 1.72
			parentanchor = center
			position = { -80 100 }
			visible = "[GetScriptedGui( 'mde_dragon_portrait_size_giant' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End )]"
		}

		icon = {
			texture = "gfx/interface/hud/bottom_left_portrait_fade.dds"
			parentanchor = bottom|left
			color = { 0.12 0.12 0.12 1 }
		}

		icon = {
			texture = "gfx/interface/hud/bottom_left_portrait_fade.dds"
			parentanchor = bottom|left
			color = { 0.15 0.15 0.15 0.3 }
		}
	}

	type agot_hud_dragon_portrait = widget
	{
		size = { 650 350 }
		allow_outside = yes

		portrait_button = {
			name = "dragon_portrait_visual"
			size = { 1100 350 }
			parentanchor = center
			alwaystransparent = yes

			gfxtype = portraitbuttongfx
			shaderfile = "gfx/FX/jomini/gui_portrait.shader"
			effectname = "NoHighlight"

			state = {
				name = "dragon_hover_enter"
				scale = 1.04
				using = Animation_Curve_Default
				duration = 0.05
			}

			state = {
				name = "dragon_hover_leave"
				scale = 1.0
				using = Animation_Curve_Default
				duration = 0.05
			}

			portrait_texture = "[Character.GetRelationOfType(GetRelation('agot_dragon')).GetAnimatedPortrait('environment_dragon_portrait', 'camera_dragon_portrait_one', 'dragon_portrait_animation', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			background_texture = "gfx/portraits/portrait_transparent.dds"
			texture = "gfx/portraits/portrait_transparent.dds"
			mask = "gfx/portraits/portrait_mask_blank.dds"
		}

		button_normal = {
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/portraits/portrait_transparent.dds"
			effectname = "NoHighlight"
			button_ignore = none

			state = {
				name = _mouse_enter
				on_start = "[Character.OnMouseEnter]"
				on_start = "[PdxGuiWidget.AccessParent.FindChild('dragon_portrait_visual').TriggerAnimation('dragon_hover_enter')]"
			}

			state = {
				name = _mouse_leave
				on_start = "[Character.OnMouseLeave]"
				on_start = "[PdxGuiWidget.AccessParent.FindChild('dragon_portrait_visual').TriggerAnimation('dragon_hover_leave')]"
			}

			state = {
				name = _mouse_release
				start_sound = {
					soundeffect = "event:/SFX/UI/Character/sfx_ui_character_portrait_select"
				}
			}

			onclick = "[DefaultOnCharacterClick(Character.GetRelationOfType(GetRelation('agot_dragon')).GetID)]"
			onrightclick = "[DefaultOnCharacterRightClick(Character.GetRelationOfType(GetRelation('agot_dragon')).GetID)]"

			clicksound = "event:/SFX/UI/Character/sfx_ui_character_portrait_select"
			oversound = "event:/SFX/UI/Character/sfx_ui_character_portrait_pointer_over"
		}
	}

	type agot_hud_giant_dragon_portrait = widget
	{
		size = { 650 350 }
		allow_outside = yes

		portrait_button = {
			name = "giant_dragon_portrait_visual"
			size = { 1100 350 }
			parentanchor = center
			alwaystransparent = yes

			gfxtype = portraitbuttongfx
			shaderfile = "gfx/FX/jomini/gui_portrait.shader"
			effectname = "NoHighlight"

			state = {
				name = "giant_dragon_hover_enter"
				scale = 1.04
				using = Animation_Curve_Default
				duration = 0.05
			}

			state = {
				name = "giant_dragon_hover_leave"
				scale = 1.0
				using = Animation_Curve_Default
				duration = 0.05
			}

			portrait_texture = "[Character.GetRelationOfType(GetRelation('agot_dragon')).GetAnimatedPortrait('environment_dragon_portrait', 'camera_dragon_portrait_two', 'dragon_portrait_animation', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			background_texture = "gfx/portraits/portrait_transparent.dds"
			texture = "gfx/portraits/portrait_transparent.dds"
			mask = "gfx/portraits/portrait_mask_blank.dds"
		}

		# ---------- CLICK: original 650x350 footprint (giant tier) ----------
		button_normal = {
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/portraits/portrait_transparent.dds"
			effectname = "NoHighlight"
			button_ignore = none

			state = {
				name = _mouse_enter
				on_start = "[Character.OnMouseEnter]"
				on_start = "[PdxGuiWidget.AccessParent.FindChild('giant_dragon_portrait_visual').TriggerAnimation('giant_dragon_hover_enter')]"
			}

			state = {
				name = _mouse_leave
				on_start = "[Character.OnMouseLeave]"
				on_start = "[PdxGuiWidget.AccessParent.FindChild('giant_dragon_portrait_visual').TriggerAnimation('giant_dragon_hover_leave')]"
			}

			state = {
				name = _mouse_release
				start_sound = {
					soundeffect = "event:/SFX/UI/Character/sfx_ui_character_portrait_select"
				}
			}

			onclick = "[DefaultOnCharacterClick(Character.GetRelationOfType(GetRelation('agot_dragon')).GetID)]"
			onrightclick = "[DefaultOnCharacterRightClick(Character.GetRelationOfType(GetRelation('agot_dragon')).GetID)]"

			clicksound = "event:/SFX/UI/Character/sfx_ui_character_portrait_select"
			oversound = "event:/SFX/UI/Character/sfx_ui_character_portrait_pointer_over"
		}
	}

	type agot_hud_baby_dragon_portrait = widget
	{
		size = { 650 350 }
		allow_outside = yes

		portrait_button = {
			name = "baby_dragon_portrait_visual"
			size = { 1100 350 }
			parentanchor = center
			alwaystransparent = yes

			gfxtype = portraitbuttongfx
			shaderfile = "gfx/FX/jomini/gui_portrait.shader"
			effectname = "NoHighlight"

			state = {
				name = "baby_dragon_hover_enter"
				scale = 1.04
				using = Animation_Curve_Default
				duration = 0.05
			}

			state = {
				name = "baby_dragon_hover_leave"
				scale = 1.0
				using = Animation_Curve_Default
				duration = 0.05
			}

			portrait_texture = "[Character.GetRelationOfType(GetRelation('agot_dragon')).GetAnimatedPortrait('environment_dragon_portrait', Character.GetRelationOfType(GetRelation('agot_dragon')).Custom('MdeDragonPortraitCamera'), 'dragon_portrait_animation', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
			background_texture = "gfx/portraits/portrait_transparent.dds"
			texture = "gfx/portraits/portrait_transparent.dds"
			mask = "gfx/portraits/portrait_mask_blank.dds"
		}

		button_normal = {
			size = { 100% 100% }
			parentanchor = center
			texture = "gfx/portraits/portrait_transparent.dds"
			effectname = "NoHighlight"
			button_ignore = none

			state = {
				name = _mouse_enter
				on_start = "[Character.OnMouseEnter]"
				on_start = "[PdxGuiWidget.AccessParent.FindChild('baby_dragon_portrait_visual').TriggerAnimation('baby_dragon_hover_enter')]"
			}

			state = {
				name = _mouse_leave
				on_start = "[Character.OnMouseLeave]"
				on_start = "[PdxGuiWidget.AccessParent.FindChild('baby_dragon_portrait_visual').TriggerAnimation('baby_dragon_hover_leave')]"
			}

			state = {
				name = _mouse_release
				start_sound = {
					soundeffect = "event:/SFX/UI/Character/sfx_ui_character_portrait_select"
				}
			}

			onclick = "[DefaultOnCharacterClick(Character.GetRelationOfType(GetRelation('agot_dragon')).GetID)]"
			onrightclick = "[DefaultOnCharacterRightClick(Character.GetRelationOfType(GetRelation('agot_dragon')).GetID)]"

			clicksound = "event:/SFX/UI/Character/sfx_ui_character_portrait_select"
			oversound = "event:/SFX/UI/Character/sfx_ui_character_portrait_pointer_over"
		}
	}
}
