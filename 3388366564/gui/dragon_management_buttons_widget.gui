widget = {
	name = "dragon_management_buttons_widget"
	parentanchor = bottom|right
	widgetanchor = bottom|right
	position = { -631 0 }
	size = { 200 36 }
	visible = "[And(Not( IsPauseMenuShown ), GetPlayer.IsValid)]"
	alwaystransparent = no
	layer = bottom
	
	flowcontainer = {
		ignoreinvisible = yes
		parentanchor = bottom|right
		#scale = 1.1
		button_round  = {
			visible = "[And(And(GetScriptedGui('mde_show_dragonpit_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "mde_dragonpits_button"
			datacontext = "[GetScriptedGui( 'mde_show_dragonpit_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "SHOW_DRAGONPITS"
			button_icon_highlight = {
				texture = "gfx/interface/icons/building_types/icon_building_dragonpit.dds"
				parentanchor = center
				alwaystransparent = yes
				position = { 1 1.5 }
				size = { 23 23 }
			}
		}
		button_round  = {
			visible = yes #"[And(And(GetScriptedGui('mde_show_dragon_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "mde_dragons_button"
			onclick = "[GetVariableSystem.Toggle('dragon_viewer_toggle')]"
			tooltip = "SHOW_DRAGONS"
			button_icon_highlight = {
				texture = "gfx/interface/icons/flat_icons/capture_wild_dragon.dds"
				parentanchor = center
				alwaystransparent = yes
				position = { 1 1.5 }
				size = { 35 35 }
			}
		}
		button_round  = {
			visible = "[And(And(GetScriptedGui('mde_show_egg_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			datacontext = "[GetScriptedGui( 'mde_show_egg_button' )]"
			name = "mde_eggs_button"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "SHOW_EGGS"
			button_icon_highlight = {
				texture = "gfx/interface/icons/artifact/dragon_egg_black.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 40 40 }
				alpha = -3500
			}
		}
		button_round  = {
			visible = "[And(And(GetScriptedGui('mde_show_kingsguard_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "mde_kingsguard_button"
			datacontext = "[GetScriptedGui( 'mde_show_kingsguard_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "SHOW_KINGSGUARD"
			button_icon_highlight = {
				texture = "gfx/interface/icons/flat_icons/kingsguard_flat_black.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 36 36 }
			}
		}
		button_round  = {
			visible = "[And(And(GetScriptedGui('mde_show_valyrian_steel_button').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			name = "mde_valyrian_steel_button"
			datacontext = "[GetScriptedGui( 'mde_show_valyrian_steel_button' )]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			tooltip = "SHOW_VALYRIAN_STEEL"
			button_icon_highlight = {
				texture = "gfx/interface/icons/inventory/weapon.dds"
				parentanchor = center
				alwaystransparent = yes
				size = { 31 31 }
			}
		}
		spacer = {
			visible = "[And(And(GetScriptedGui('mde_button_spacer_for_hud_skins').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(IsGameViewOpen('barbershop'))), IsDefaultGUIMode)]"
			size = { 12 0 } 
		}
	}
}
