##################################################################
#################### AGOT DRAGON EVENT WINDOW ####################
##################################################################

types Events
{
}

types Scrollbar
{
	type mde_scrollbox = scrollarea {
		size = { 100 100 }

		scrollbarpolicy_vertical = always_off
		

		block "scrollbox_scrollbar_horizontal"
		{
			scrollbar_horizontal = {
				using = Scrollbar_Horizontal
			}
		}

		block "scrollbox_background"
		{
			background = {
				using = Background_Area
			}
		}

		scrollwidget = {
			block "scrollbox_replace_hbox"
			{
				hbox = {
					block "scrollbox_margins"
					{
						using = Scrollbox_Margins
					}
					text_single = {
						layoutpolicy_horizontal = expanding
						default_format = "#weak"

						block "scrollbox_empty"
						{
							visible = no
						}
					}

					block "scrollbox_expand"
					{
						expand = {
							layoutpolicy_horizontal = growing
						}
					}
				}
			}
		}

		block "scrollbox_background_fade" {
			icon = {
				name = "scrollbar_fade"
				texture = "gfx/interface/scrollbars/scrollbar_fade.dds"
				size = { 100% 100% }
				alwaystransparent = yes

				spriteType = Corneredtiled
				spriteborder = { 0 30 }
			}
		}
	}
}