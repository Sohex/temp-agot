	# Drawn last so the full-body character stays above all window fades,
	# illustrated cards, and detail panels, matching the vanilla lifestyle view.
	widget = {
		parentanchor = bottom|left
		size = { 270 560 }
		allow_outside = no
		alpha = 1
		datacontext = "[GetPlayer]"

		portrait_lifestyles = {
			parentanchor = bottom|left
			position = { -200 0 }
			alpha = 1
		}
	}

	# Vote forecast is a true modal: the full-screen layer consumes every mouse
	# event. Anchor the percentage-sized blocker to the viewport's top-left;
	# centering a 100% child makes Clausewitz resolve its bounds incorrectly.
	widget = {
		visible = "[GetScriptedGui('dragonlord_council_toggle_vote_forecast').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		parentanchor = top|left
		widgetanchor = top|left
		size = { 100% 100% }
		allow_outside = no
		alwaystransparent = no
		filter_mouse = all
		layer = top
		background = { using = Background_Area_Dark alpha = 0.78 }

		widget = {
			parentanchor = center
			widgetanchor = center
			size = { 1200 800 }
			allow_outside = no
			alwaystransparent = no
			filter_mouse = all
			using = Window_Background
			using = Window_Decoration

			header_pattern = {
				parentanchor = top|hcenter
				widgetanchor = top|hcenter
				position = { 0 16 }
				size = { 1120 50 }
				blockoverride "header_text" { text = dragonlord_council_vote_forecast_header }
				blockoverride "button_close" {
					datacontext = "[GetScriptedGui('dragonlord_council_toggle_vote_forecast')]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			text_multi = {
				parentanchor = top|hcenter
				widgetanchor = top|hcenter
				position = { 0 82 }
				size = { 1120 52 }
				text = dragonlord_council_vote_forecast_desc
				default_format = "#weak"
				align = center
				margin = { 16 6 }
			}

			widget = {
				parentanchor = top|left
				widgetanchor = top|left
				position = { 40 146 }
				size = { 1120 614 }

				vbox = {
					parentanchor = top|left
					widgetanchor = top|left
					position = { 32 0 }
					size = { 520 614 }
					minimumsize = { 520 614 }
					maximumsize = { 520 614 }
					background = { using = Background_Area }
					background = { using = Background_Frame alpha = 0.55 }
					text_single = {
						size = { 520 56 }
						minimumsize = { 520 56 }
						maximumsize = { 520 56 }
						autoresize = no
						background = {
							texture = "gfx/interface/component_tiles/header_full_window_background.dds"
							spriteType = Corneredtiled
							spriteborder = { 128 8 }
						}
						text = dragonlord_council_expected_support
						using = Font_Size_Medium
						default_format = "#positive_value"
						align = center|vcenter
					}
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbarpolicy_vertical = as_needed
						scrollbar_vertical = { using = Scrollbar_Vertical }
						blockoverride "scrollbox_margins" {
							margin_top = 12
							margin_bottom = 12
							margin_left = 0
							margin_right = 24
						}
						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[GetPlayer.MakeScope.GetList('dragonlord_council_forecast_supporters')]"
								spacing = 6
								item = {
									hbox = {
										layoutpolicy_horizontal = expanding
										dragonlord_council_vote_forecast_entry = {}
										expand = {}
									}
								}
							}
						}
						blockoverride "scrollbox_empty" {
							visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('dragonlord_council_forecast_supporters'))]"
							text = dragonlord_council_vote_forecast_empty
						}
					}
				}

				vbox = {
					parentanchor = top|left
					widgetanchor = top|left
					position = { 568 0 }
					size = { 520 614 }
					minimumsize = { 520 614 }
					maximumsize = { 520 614 }
					background = { using = Background_Area }
					background = { using = Background_Frame alpha = 0.55 }
					text_single = {
						size = { 520 56 }
						minimumsize = { 520 56 }
						maximumsize = { 520 56 }
						autoresize = no
						background = {
							texture = "gfx/interface/component_tiles/header_full_window_background.dds"
							spriteType = Corneredtiled
							spriteborder = { 128 8 }
						}
						text = dragonlord_council_expected_opposition
						using = Font_Size_Medium
						default_format = "#negative_value"
						align = center|vcenter
					}
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						scrollbarpolicy_horizontal = always_off
						scrollbarpolicy_vertical = as_needed
						scrollbar_vertical = { using = Scrollbar_Vertical }
						blockoverride "scrollbox_margins" {
							margin_top = 12
							margin_bottom = 12
							margin_left = 0
							margin_right = 24
						}
						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[GetPlayer.MakeScope.GetList('dragonlord_council_forecast_opponents')]"
								spacing = 6
								item = {
									hbox = {
										layoutpolicy_horizontal = expanding
										dragonlord_council_vote_forecast_entry = {}
										expand = {}
									}
								}
							}
						}
						blockoverride "scrollbox_empty" {
							visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('dragonlord_council_forecast_opponents'))]"
							text = dragonlord_council_vote_forecast_empty
						}
					}
				}
			}
		}
	}
}
