types DragonlordCouncilAgenda
{
	type dragonlord_council_selected_motion_text = text_single {
		parentanchor = left|vcenter
		widgetanchor = left|vcenter
		position = { 118 0 }
		align = left|vcenter
		max_width = 350
		elide = right
	}

	type dragonlord_council_target_entry = button_standard {
		name = "dragonlord_council_target_entry"
		size = { 560 68 }
		datacontext = "[Scope.GetCharacter]"
		onclick = "[GetScriptedGui('dragonlord_council_select_war_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
		down = "[GetScriptedGui('dragonlord_council_select_war_target').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
		portrait_head_small = { scale = 0.75 tooltip_visible = no }
		text_single = {
			position = { 72 0 }
			size = { 470 68 }
			autoresize = no
			text = "[Character.GetUINameNoTooltip]"
			using = Font_Size_Medium
			default_format = "#high"
			align = left|vcenter
			max_width = 470
			elide = right
		}
	}

	type dragonlord_council_development_county_entry = button_standard {
		name = "dragonlord_council_development_county_entry"
		size = { 560 68 }
		datacontext = "[Scope.Title]"
		onclick = "[GetScriptedGui('dragonlord_council_select_development_county_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Title.MakeScope).End)]"
		down = "[GetScriptedGui('dragonlord_council_select_development_county_target').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Title.MakeScope).End)]"
		coa_title_small_crown = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 8 0 }
			scale = 0.78
			tooltip_visible = no
		}
		text_single = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 72 -13 }
			size = { 450 30 }
			text = "[Title.GetNameNoTierNoTooltip]"
			using = Font_Size_Medium
			default_format = "#high"
			align = left|vcenter
			elide = right
		}
		text_single = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 72 15 }
			size = { 450 24 }
			text = "[Title.GetHolder.GetUINameNoTooltip]"
			default_format = "#weak"
			align = left|vcenter
			elide = right
		}
	}

	type dragonlord_council_development_estate_entry = button_standard {
		name = "dragonlord_council_development_estate_entry"
		size = { 560 68 }
		datacontext = "[Scope.GetCharacter]"
		onclick = "[GetScriptedGui('dragonlord_council_select_development_estate_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
		down = "[GetScriptedGui('dragonlord_council_select_development_estate_target').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Character.MakeScope).End)]"
		portrait_head_small = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 4 0 }
			scale = 0.78
			tooltip_visible = no
		}
		text_single = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 72 -13 }
			size = { 450 30 }
			text = "[Character.GetUINameNoTooltip]"
			using = Font_Size_Medium
			default_format = "#high"
			align = left|vcenter
			elide = right
		}
		text_single = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 72 15 }
			size = { 450 24 }
			text = ADMINISTRATIVE_GOVERNMENT_HOUSE_WITH_NAME
			default_format = "#weak"
			align = left|vcenter
			elide = right
		}
	}

	type dragonlord_council_vote_forecast_entry = widget {
		size = { 496 72 }
		datacontext = "[Scope.GetCharacter]"
		background = { using = Background_Area margin = { 0 2 } }
		background = { using = Background_Area_Border margin = { 0 2 } alpha = 0.55 }

		portrait_head_small = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 8 0 }
			scale = 0.82
			tooltip_visible = yes
		}

		text_single = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 78 -13 }
			size = { 226 28 }
			autoresize = no
			text = "[Character.GetUINameNoTooltip]"
			using = Font_Size_Medium
			default_format = "#high"
			align = left|vcenter
			max_width = 226
			elide = right
		}

		text_single = {
			parentanchor = left|vcenter
			widgetanchor = left|vcenter
			position = { 78 15 }
			size = { 226 24 }
			autoresize = no
			text = "ADMINISTRATIVE_GOVERNMENT_HOUSE_WITH_NAME"
			default_format = "#weak"
			align = left|vcenter
			max_width = 226
			elide = right
		}

		# The stance score remains visible and retains its detailed reason
		# breakdown; the ballot icon to its right shows actual voting weight.
		button = {
			parentanchor = right|vcenter
			widgetanchor = right|vcenter
			position = { -80 0 }
			size = { 88 32 }
			alwaystransparent = no
			text_single = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				size = { 44 28 }
				text = dragonlord_council_vote_support_short
				using = Font_Size_Tiny
				default_format = "#weak"
				align = left|vcenter
			}
			text_single = {
				parentanchor = right|vcenter
				widgetanchor = right|vcenter
				size = { 44 32 }
				text = "[GuiScope.SetRoot( Character.MakeScope ).AddScope( 'dragonlord_council_vote_proposer', GetPlayer.MakeScope ).ScriptValue( 'dragonlord_council_vote_support_score' )|+=0]"
				using = Font_Size_Small
				default_format = "#high"
				align = right|vcenter
			}
			tooltip_visible = yes
			using = tooltip_se
			tooltipwidget = {
				widget_value_breakdown_tooltip = {
					datacontext = "[GuiScope.SetRoot( Character.MakeScope ).AddScope( 'dragonlord_council_vote_proposer', GetPlayer.MakeScope ).GetScriptValueBreakdown( 'dragonlord_council_vote_support_score' )]"
					blockoverride "header" {
						text_label_left = {
							layoutpolicy_horizontal = expanding
							text = dragonlord_council_vote_score_header
							default_format = "#T"
						}
					}
				}
			}
		}

		widget = {
			parentanchor = right|vcenter
			widgetanchor = right|vcenter
			position = { -68 0 }
			size = { 1 40 }
			background = { using = Background_Area alpha = 0.55 }
		}

		button = {
			parentanchor = right|vcenter
			widgetanchor = right|vcenter
			position = { -8 0 }
			size = { 48 32 }
			alwaystransparent = no
			allow_outside = yes
			icon_flat_standard = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				position = { 0 0 }
				size = { 22 22 }
				texture = "gfx/interface/icons/flat_icons/election_vote_strength.dds"
			}
			text_single = {
				parentanchor = left|vcenter
				widgetanchor = left|vcenter
				position = { 26 0 }
				size = { 24 32 }
				text = "[GuiScope.SetRoot( Character.MakeScope ).ScriptValue( 'dragonlord_council_vote_weight' )|0]"
				using = Font_Size_Medium
				default_format = "#high"
				align = center|vcenter
			}
			tooltip_visible = yes
			using = tooltip_se
			tooltipwidget = {
				widget_value_breakdown_tooltip = {
					datacontext = "[GuiScope.SetRoot( Character.MakeScope ).GetScriptValueBreakdown( 'dragonlord_council_vote_weight' )]"
					blockoverride "header" {
						text_label_left = {
							layoutpolicy_horizontal = expanding
							text = dragonlord_council_vote_weight_header
							default_format = "#T"
						}
					}
				}
			}
	}
}
}

window = {
	name = "dragonlord_council_agenda_window"
	allow_outside = no
	movable = no
	parentanchor = center
	size = { 100% 100% }
	filter_mouse = all
	layer = middle
	using = Window_Background_No_Edge
	visible = "[And(IsInGame, GetScriptedGui('dragonlord_council_agenda_window').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
	state = { name = _show using = Animation_FadeIn_Standard using = Sound_WindowShow_Standard using = Sound_Window_AmbienceMute_Snapshot }
	state = { name = _hide using = Animation_FadeOut_Standard using = Sound_WindowHide_Standard }

	background = {
		texture = "gfx/interface/component_masks/mask_fade_corner.dds"
		color = { 0.12 0.12 0.12 1 }
		mirror = horizontal
		margin_right = -1200
		alpha = 0.6
	}

	# Category selection screen. Like the lifestyle picker, this is the only
	# content shown until the player chooses one of the large illustrated cards.
	vbox = {
		name = "dragonlord_council_category_selection"
		visible = "[Not(GetPlayer.MakeScope.Var('dragonlord_council_selected_agenda_category').IsSet)]"
		margin_top = 10
		state = { name = _show using = Animation_FadeIn_Quick }
		state = { name = _hide using = Animation_FadeOut_Quick }
		background = { using = Background_Bottom_Fade }
		background = { using = Background_Area_Dark margin = { 0 -100 } alpha = 0.3 }
		spacer = { size = { 0 50 } }

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 0 150 }
			margin_left = 320
			margin_right = 40
			spacing = 0
			max_width = 2080
			expand = {}
			hbox = {
				size = { 1550 700 }
				spacing = 10
			button_normal = {
				size = { 250 700 }
				using = TabShortcut
				effectname = "NoHighlight"
				texture = "gfx/interface/illustrations/dragonlord_council/law.dds"
				modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredstretched spriteborder = { 30 30 } }
				onclick = "[GetScriptedGui('dragonlord_council_select_law_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				button = {
					size = { 100% 100% }
					alpha = 0
					onclick = "[GetScriptedGui('dragonlord_council_select_law_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					state = { name = _mouse_enter alpha = 1 }
					state = { name = _mouse_leave alpha = 0 }
					background = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_hover.dds" spriteType = Corneredtiled spriteborder = { 30 30 } modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				}
				icon = { size = { 100% 100% } using = Background_Bottom_Fade mirror = vertical modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				icon = { parentanchor = top|hcenter widgetanchor = top|hcenter position = { 0 -50 } size = { 120 120 } framesize = { 160 160 } texture = "gfx/interface/icons/dragonlord_council/law.dds" }
				vbox = {
					margin = { 10 30 }
					margin_top = 60
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 15
						spacing = 20
						text_single = { layoutpolicy_horizontal = expanding autoresize = no text = dragonlord_council_agenda_category_law using = Font_Type_Flavor fontsize = 25 default_format = "#high" align = nobaseline|hcenter }
						text_multi = { layoutpolicy_horizontal = expanding size = { 100 130 } text = dragonlord_council_agenda_category_law_desc align = top|hcenter margin = { 5 0 } }
						expand = {}
					}
					expand = {}
				}
			}

			button_normal = {
				size = { 250 700 }
				using = TabShortcut
				effectname = "NoHighlight"
				texture = "gfx/interface/illustrations/dragonlord_council/conquest.dds"
				modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredstretched spriteborder = { 30 30 } }
				onclick = "[GetScriptedGui('dragonlord_council_select_war_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				button = {
					size = { 100% 100% }
					alpha = 0
					onclick = "[GetScriptedGui('dragonlord_council_select_war_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					state = { name = _mouse_enter alpha = 1 }
					state = { name = _mouse_leave alpha = 0 }
					background = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_hover.dds" spriteType = Corneredtiled spriteborder = { 30 30 } modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				}
				icon = { size = { 100% 100% } using = Background_Bottom_Fade mirror = vertical modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				icon = { parentanchor = top|hcenter widgetanchor = top|hcenter position = { 0 -50 } size = { 120 120 } framesize = { 160 160 } texture = "gfx/interface/icons/dragonlord_council/conquest.dds" }
				vbox = {
					margin = { 10 30 }
					margin_top = 60
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 15
						spacing = 20
						text_single = { layoutpolicy_horizontal = expanding autoresize = no text = dragonlord_council_agenda_category_war using = Font_Type_Flavor fontsize = 25 default_format = "#high" align = nobaseline|hcenter }
						text_multi = { layoutpolicy_horizontal = expanding size = { 100 130 } text = dragonlord_council_agenda_category_war_desc align = top|hcenter margin = { 5 0 } }
						expand = {}
					}
					expand = {}
				}
			}

			button_normal = {
				size = { 250 700 }
				using = TabShortcut
				effectname = "NoHighlight"
				texture = "gfx/interface/illustrations/dragonlord_council/development.dds"
				modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredstretched spriteborder = { 30 30 } }
				onclick = "[GetScriptedGui('dragonlord_council_select_development_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				button = {
					size = { 100% 100% }
					alpha = 0
					onclick = "[GetScriptedGui('dragonlord_council_select_development_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					state = { name = _mouse_enter alpha = 1 }
					state = { name = _mouse_leave alpha = 0 }
					background = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_hover.dds" spriteType = Corneredtiled spriteborder = { 30 30 } modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				}
				icon = { size = { 100% 100% } using = Background_Bottom_Fade mirror = vertical modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				icon = { parentanchor = top|hcenter widgetanchor = top|hcenter position = { 0 -50 } size = { 120 120 } framesize = { 160 160 } texture = "gfx/interface/icons/dragonlord_council/development.dds" }
				vbox = {
					margin = { 10 30 }
					margin_top = 60
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 15
						spacing = 20
						text_single = { layoutpolicy_horizontal = expanding autoresize = no text = dragonlord_council_agenda_category_development using = Font_Type_Flavor fontsize = 25 default_format = "#high" align = nobaseline|hcenter }
						text_multi = { layoutpolicy_horizontal = expanding size = { 100 130 } text = dragonlord_council_agenda_category_development_desc align = top|hcenter margin = { 5 0 } }
						expand = {}
					}
					expand = {}
				}
			}

			button_normal = {
				size = { 250 700 }
				using = TabShortcut
				effectname = "NoHighlight"
				texture = "gfx/interface/illustrations/dragonlord_council/finance.dds"
				modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredstretched spriteborder = { 30 30 } }
				onclick = "[GetScriptedGui('dragonlord_council_select_finance_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				button = {
					size = { 100% 100% }
					alpha = 0
					onclick = "[GetScriptedGui('dragonlord_council_select_finance_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					state = { name = _mouse_enter alpha = 1 }
					state = { name = _mouse_leave alpha = 0 }
					background = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_hover.dds" spriteType = Corneredtiled spriteborder = { 30 30 } modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				}
				icon = { size = { 100% 100% } using = Background_Bottom_Fade mirror = vertical modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				icon = { parentanchor = top|hcenter widgetanchor = top|hcenter position = { 0 -50 } size = { 120 120 } framesize = { 160 160 } texture = "gfx/interface/icons/dragonlord_council/finance.dds" }
				vbox = {
					margin = { 10 30 }
					margin_top = 60
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 15
						spacing = 20
						text_single = { layoutpolicy_horizontal = expanding autoresize = no text = dragonlord_council_agenda_category_finance using = Font_Type_Flavor fontsize = 25 default_format = "#high" align = nobaseline|hcenter }
						text_multi = { layoutpolicy_horizontal = expanding size = { 100 130 } text = dragonlord_council_agenda_category_finance_desc align = top|hcenter margin = { 5 0 } }
						expand = {}
					}
					expand = {}
				}
			}

			button_normal = {
				size = { 250 700 }
				using = TabShortcut
				effectname = "NoHighlight"
				texture = "gfx/interface/illustrations/dragonlord_council/ritual.dds"
				modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredstretched spriteborder = { 30 30 } }
				onclick = "[GetScriptedGui('dragonlord_council_select_ritual_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				button = {
					size = { 100% 100% }
					alpha = 0
					onclick = "[GetScriptedGui('dragonlord_council_select_ritual_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					state = { name = _mouse_enter alpha = 1 }
					state = { name = _mouse_leave alpha = 0 }
					background = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_hover.dds" spriteType = Corneredtiled spriteborder = { 30 30 } modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				}
				icon = { size = { 100% 100% } using = Background_Bottom_Fade mirror = vertical modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				icon = { parentanchor = top|hcenter widgetanchor = top|hcenter position = { 0 -50 } size = { 120 120 } framesize = { 160 160 } texture = "gfx/interface/icons/dragonlord_council/ritual.dds" }
				vbox = {
					margin = { 10 30 }
					margin_top = 60
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 15
						spacing = 20
						text_single = { layoutpolicy_horizontal = expanding autoresize = no text = dragonlord_council_agenda_category_ritual using = Font_Type_Flavor fontsize = 25 default_format = "#high" align = nobaseline|hcenter }
						text_multi = { layoutpolicy_horizontal = expanding size = { 100 130 } text = dragonlord_council_agenda_category_ritual_desc align = top|hcenter margin = { 5 0 } }
						expand = {}
					}
					expand = {}
				}
			}

			button_normal = {
				size = { 250 700 }
				using = TabShortcut
				effectname = "NoHighlight"
				texture = "gfx/interface/illustrations/dragonlord_council/in_development.dds"
				modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredstretched spriteborder = { 30 30 } }
				onclick = "[GetScriptedGui('dragonlord_council_select_dragon_affairs_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				button = {
					size = { 100% 100% }
					alpha = 0
					onclick = "[GetScriptedGui('dragonlord_council_select_dragon_affairs_agenda').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					state = { name = _mouse_enter alpha = 1 }
					state = { name = _mouse_leave alpha = 0 }
					background = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_hover.dds" spriteType = Corneredtiled spriteborder = { 30 30 } modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				}
				icon = { size = { 100% 100% } using = Background_Bottom_Fade mirror = vertical modify_texture = { texture = "gfx/interface/window_lifestyles/lifestyles_illustration_mask.dds" blend_mode = alphamultiply spriteType = Corneredtiled spriteborder = { 30 30 } } }
				icon = { parentanchor = top|hcenter widgetanchor = top|hcenter position = { 0 -50 } size = { 120 120 } framesize = { 160 160 } texture = "gfx/interface/icons/dragonlord_council/in_development.dds" }
				vbox = {
					margin = { 10 30 }
					margin_top = 60
					vbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 15
						spacing = 20
						text_single = { layoutpolicy_horizontal = expanding autoresize = no text = dragonlord_council_agenda_category_dragon_affairs using = Font_Type_Flavor fontsize = 25 default_format = "#high" align = nobaseline|hcenter }
						text_multi = { layoutpolicy_horizontal = expanding size = { 100 130 } text = dragonlord_council_agenda_category_dragon_affairs_desc align = top|hcenter margin = { 5 0 } }
						expand = {}
					}
					expand = {}
				}
			}
			}
			expand = {}
		}
	}

	# Kept outside the card layout so it is never covered or vertically compressed.
	header_standard = {
		visible = "[Not(GetPlayer.MakeScope.Var('dragonlord_council_selected_agenda_category').IsSet)]"
		parentanchor = top|hcenter
		widgetanchor = top|hcenter
		position = { 0 10 }
		size = { 100% 50 }
		blockoverride "header_text" { text = dragonlord_council_agenda_window_title }
		blockoverride "button_close" {
			datacontext = "[GetScriptedGui('dragonlord_council_agenda_window')]"
			onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
	}

	vbox = {
		name = "dragonlord_council_detail_view"
		visible = "[GetPlayer.MakeScope.Var('dragonlord_council_selected_agenda_category').IsSet]"
		using = Window_Margins
		# Keep the complete framed body above the bottom HUD, matching the
		# lifestyle focus view's usable content area instead of full screen height.
		margin_bottom = 64
		state = { name = _show using = Animation_FadeIn_Quick }
		state = { name = _hide using = Animation_FadeOut_Quick }
