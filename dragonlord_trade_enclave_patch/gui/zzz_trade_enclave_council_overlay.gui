# Fifth war-type selector for the Dragonlord Council.
# Kept as a small overlay so this patch does not replace the base mod's entire
# council window. It is deliberately on the top layer to avoid being occluded
# by the full-screen council planner.
window = {
    name = "dragonlord_trade_enclave_war_selector_patch"
    allow_outside = yes
    movable = no
    parentanchor = center
    widgetanchor = center
    position = { -500 245 }
    size = { 260 62 }
    layer = top
    alpha = 1

    visible = "[And(IsInGame, GetScriptedGui('dragonlord_council_select_war_agenda').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"

    state = {
        name = _show
        using = Animation_FadeIn_Quick
        on_start = "[PdxGuiWidget.StackTop]"
    }

    button_standard = {
        size = { 260 54 }
        down = "[GetScriptedGui('dragonlord_council_select_trade_enclave_war').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        onclick = "[GetScriptedGui('dragonlord_council_select_trade_enclave_war').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
        tooltip = dragonlord_council_trade_enclave_war_desc
        text_single = {
            parentanchor = center
            widgetanchor = center
            text = dragonlord_council_trade_enclave_war
            using = Font_Size_Medium
        }
    }
}
