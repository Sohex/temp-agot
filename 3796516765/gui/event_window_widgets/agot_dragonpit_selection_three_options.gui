# Dragonpit destination picker with Dragonlord Estates represented by their
# noble-family title and labelled as the Topless Towers.
widget = {
	allow_outside = yes
	name = "agot_dragonpit_selection_three_options"
	size = { 440 196 }

	vbox = {
		allow_outside = yes
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		position = { 0 4 }

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_content" {
				vbox = {
					# Character events displayed to a human always belong to the
					# current player. Keep AGOT's native GUI root so button clicks
					# write selected_title back to the event recipient reliably.
					datamodel = "[GetPlayer.MakeScope.GetList('possible_titles')]"
					layoutpolicy_horizontal = expanding

					item = {
						button_standard = {
							name = "background_button"
							size = { 402 68 }
							using = tooltip_ws
							layoutpolicy_vertical = expanding
							datacontext = "[Scope.Title]"
							onclick = "[GetScriptedGui('dragonlord_choose_dragonpit_set_selected_title').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_title', Title.MakeScope).End)]"
							down = "[GetScriptedGui('dragonlord_choose_dragonpit_set_selected_title').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_title', Title.MakeScope).End)]"

							tooltipwidget = { using = LandedTitleTooltip }
							tooltip_offset = { 0 0 }
							tooltip_verticalbehavior = slide
							tooltip_horizontalbehavior = mirror

							coa_title_small_crown = {
								scale = 0.85
								position = { 10 -6 }
								tooltip_visible = no
							}
							text_single = {
								name = "title_name"
								text = "[Select_CString( Title.MakeScope.Var( 'dragonlord_family_title' ).IsSet, Localize( 'dragonlord_topless_towers_dragonpit_selection' ), Title.GetNameNoTierNoTooltip )]"
								using = Font_Size_Medium
								align = center
								max_width = 320
								position = { 70 18 }
							}
							expand = {}
						}
					}
					expand = {}
				}
			}
		}
	}
}
